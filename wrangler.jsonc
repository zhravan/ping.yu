{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ping-yu",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
